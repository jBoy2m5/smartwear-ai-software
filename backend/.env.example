SMARTWEAR_ENVIRONMENT=development
SMARTWEAR_API_PREFIX=/api/v1
SMARTWEAR_DATABASE_URL=sqlite:///backend/data/smartwear.db
SMARTWEAR_STATIC_DIR=backend/static
SMARTWEAR_PDF_DIR=backend/static/pdf
SMARTWEAR_KEYFRAME_DIR=backend/static/images
SMARTWEAR_DATASET_DIR=backend/static/dataset
SMARTWEAR_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
SMARTWEAR_LOG_LEVEL=INFO
SMARTWEAR_MAX_PAGE_SIZE=100
SMARTWEAR_MAX_KEYFRAME_BYTES=10485760
# Required when SMARTWEAR_ENVIRONMENT=production.
SMARTWEAR_API_KEY=

